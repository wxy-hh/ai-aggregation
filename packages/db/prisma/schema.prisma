generator client {
  provider      = "prisma-client-js"
  // 本地 macOS + Vercel Linux（OpenSSL 3）运行时引擎
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?
  name          String?
  passwordHash  String?
  role          String   @default("user")   // 用户角色："user"（普通用户）| "admin"（管理员）
  status        String   @default("active") // 账号状态："active"（正常）| "disabled"（已禁用）
  tokens        Int      @default(20000)    // AI Token 剩余额度（每次调用按实际用量扣减）
  memorySearchEnabled Boolean @default(false) @map("memory_search_enabled") // 会话记忆检索开关（默认关闭，opt-in）
  emailVerified DateTime?
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions            ChatSession[]
  tasks               Task[]
  aiUsageRecords      AIUsageRecord[]
  voiceTranscriptions VoiceTranscription[]
  chatHistory         ChatHistory[]        @relation("ChatHistoryToUser")
  imageHistory        ImageHistory[]       @relation("ImageHistoryToUser")
  voiceHistory        VoiceHistory[]       @relation("VoiceHistoryToUser")
  oauthAccounts       OAuthAccount[]
  refreshTokens       RefreshToken[]
  feedbacks           Feedback[]
  feedbackReplies     FeedbackReply[]
  quotaAccount        QuotaAccount?
  quotaReservations   QuotaReservation[]
  quotaLedgerEntries  QuotaLedgerEntry[]
  webhookTools        UserWebhookTool[]
  webhookToolCalls    WebhookToolCall[]
  mcpServerConfigs    McpServerConfig[]
  mcpToolSnapshots   McpToolSnapshot[]
  mcpToolPolicies    McpToolPolicy[]
  mcpAuditRecords    McpAuditRecord[]
  productEvents       ProductEvent[]
  agentRuns           AgentRun[]
  knowledgeBases      KnowledgeBase[]
  documents           Document[]
  documentChunks      DocumentChunk[]
  conversationMemoryChunks ConversationMemoryChunk[]
  knowledgeFaqs       KnowledgeFaq[]
  knowledgeFaqQuestions KnowledgeFaqQuestion[]
  @@map("users")
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  memoryChunks ConversationMemoryChunk[]

  @@index([userId])
  @@map("chat_sessions")
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String   @db.Text
  // 记忆输入消息的轮次与完成身份（ADR-0058）；普通聊天历史不使用这两列
  turnId    String?  @map("turn_id")
  requestId String?  @map("request_id")
  // 幂等键：user 为 turn:<turnId>，assistant 为 complete:<requestId>
  idempotencyKey String? @map("idempotency_key")
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId])
  @@index([sessionId, turnId])
  @@map("messages")
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  requestId   String?
  providerTaskId String?
  type        String
  status      String    @default("pending")
  input       Json
  output      Json?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@unique([userId, requestId])
  @@unique([userId, providerTaskId])
  @@map("tasks")
}

model AIUsageRecord {
  id              String   @id @default(cuid())
  userId          String
  feature         String
  action          String
  provider        String?
  model           String?
  endpoint        String?
  requestId       String?
  inputTokens     Int?
  outputTokens    Int?
  totalTokens     Int?
  cachedTokens    Int?
  reasoningTokens Int?
  taskCount       Int      @default(1)
  status          String   @default("success")
  meterType       String?
  billableUnits   Int?
  billingStatus   String?
  reservationId   String?  @unique
  rawUsage        Json?
  metadata        Json?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation QuotaReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, feature, createdAt])
  @@index([provider, model])
  @@unique([userId, requestId])
  @@map("ai_usage_records")
}

model QuotaAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  grantedUnits   Int      @default(0)
  availableUnits Int      @default(0)
  reservedUnits  Int      @default(0)
  settledUnits   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations    QuotaReservation[]
  ledgerEntries   QuotaLedgerEntry[]

  @@map("quota_accounts")
}

model QuotaReservation {
  id             String   @id @default(cuid())
  userId         String
  requestId      String
  feature        String
  provider       String?
  model          String?
  meterType      String   @default("tokens")
  estimatedUnits Int
  settledUnits   Int      @default(0)
  status         String   @default("reserved")
  executionState String   @default("ready")
  expiresAt      DateTime
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "quota_reservations_user_id_fkey")
  account       QuotaAccount       @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "quota_reservations_account_user_id_fkey")
  aiUsageRecord AIUsageRecord?
  ledgerEntries QuotaLedgerEntry[]

  @@unique([userId, requestId])
  @@index([status, executionState, expiresAt])
  @@index([userId, createdAt])
  @@map("quota_reservations")
}

model QuotaLedgerEntry {
  id            String   @id @default(cuid())
  userId        String
  reservationId String?
  requestId     String
  eventType     String
  units         Int
  meterType     String
  feature       String?
  provider      String?
  model         String?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "quota_ledger_entries_user_id_fkey")
  account     QuotaAccount       @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "quota_ledger_entries_account_user_id_fkey")
  reservation QuotaReservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([requestId, eventType])
  @@index([userId, createdAt])
  @@index([reservationId])
  @@map("quota_ledger_entries")
}

model VoiceTranscription {
  id            String    @id @default(cuid())
  userId        String
  fileName      String
  fileSize      Int
  duration      Int?
  format        String
  model         String    @default("FunAudioLLM/SenseVoiceSmall")
  status        String    @default("pending")
  transcription String?   @db.Text
  error         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("voice_transcriptions")
}

model ChatHistory {
  id        String   @id @default(cuid())
  userId    String
  title     String
  preview   String   @db.Text
  model     String
  provider  String
  messages  Json
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, name: "ChatHistoryToUser")

  @@index([userId])
  @@index([createdAt])
  @@map("chat_history")
}

model ImageHistory {
  id            String   @id @default(cuid())
  userId        String
  title         String?
  prompt        String   @db.Text
  negativePrompt String?  @db.Text
  model         String
  style         String?
  aspectRatio   String?
  imageUrl      String
  parameters    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, name: "ImageHistoryToUser")

  @@index([userId])
  @@index([createdAt])
  @@map("image_history")
}

model VoiceHistory {
  id            String   @id @default(cuid())
  userId        String
  title         String
  preview       String   @db.Text
  model         String
  duration      String
  fileName      String
  fileSize      Int
  transcription String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, name: "VoiceHistoryToUser")

  @@index([userId])
  @@index([createdAt])
  @@map("voice_history")
}

// 反馈类型枚举
enum FeedbackType {
  BUG
  FEATURE
  UI
  PERFORMANCE
  OTHER
}

// 反馈状态枚举
enum FeedbackStatus {
  PENDING
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

// 反馈优先级枚举
enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Feedback {
  id          String           @id @default(cuid())
  userId      String
  type        FeedbackType
  status      FeedbackStatus   @default(PENDING)
  priority    FeedbackPriority @default(MEDIUM)
  title       String
  content     String           @db.Text
  isPinned    Boolean          @default(false)
  tags        String[]         @default([])
  replyCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     FeedbackReply[]
  attachments FeedbackAttachment[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([isPinned])
  @@index([createdAt])
  @@map("feedbacks")
}

model FeedbackReply {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  content    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([userId])
  @@index([createdAt])
  @@map("feedback_replies")
}

model FeedbackAttachment {
  id         String   @id @default(cuid())
  feedbackId String
  fileName   String
  fileSize   Int
  fileType   String
  fileUrl    String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@map("feedback_attachments")
}

model FeedbackTag {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#5D7CFA")
  description String?
  createdAt   DateTime @default(now())

  @@map("feedback_tags")
}

// Webhook 请求方法枚举
enum WebhookHttpMethod {
  GET
  POST
}

// 用户自定义 Webhook 工具定义
model UserWebhookTool {
  id                 String            @id @default(cuid())
  userId             String
  name               String
  callName           String
  description        String            @db.Text
  url                String            @db.Text
  method             WebhookHttpMethod @default(POST)
  authHeaderName     String?
  authHeaderValueEnc String?           @db.Text
  params             Json              @default("[]")
  enabled            Boolean           @default(true)
  // 调用前是否需要用户确认（AGENT-HITL-ACTION / ADR-0041）：新建时 POST 默认 true、GET 默认 false，由 API 层按 method 填入
  requiresApproval   Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  calls              WebhookToolCall[]

  @@unique([userId, callName])
  @@index([userId])
  @@index([userId, enabled])
  @@map("user_webhook_tools")
}

// Webhook 工具调用审计记录
model WebhookToolCall {
  id            String            @id @default(cuid())
  userId        String
  toolId        String?
  hostname      String
  method        WebhookHttpMethod
  statusCode    Int?
  durationMs    Int
  responseBytes Int               @default(0)
  outcome       String            // 结果状态：success / failed / skipped / blocked / pending_approval（等待用户确认，不计入成功率分母）
  errorKind     String?
  createdAt     DateTime          @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool          UserWebhookTool?  @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([toolId])
  @@index([createdAt])
  @@map("webhook_tool_calls")
}

// MCP 服务器配置（个人私有；ADR-0064）
model McpServerConfig {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  // Streamable HTTP 端点地址（HTTPS-only，登记时零 I/O 校验）
  url                String   @db.Text
  // 静态鉴权头名（可空表示无鉴权）
  authHeaderName     String?
  // 静态鉴权头取值密文（AES-256-GCM；复用 WEBHOOK_SECRET_KEY，永不回显）
  authHeaderValueEnc String?  @db.Text
  // 是否启用（停用即不向 Agent 提供工具）
  isActive           Boolean  @default(true) @map("is_active")
  // 最近一次发现状态：never / succeeded / failed
  discoveryStatus    String   @default("never") @map("discovery_status")
  // 最近一次发现失败的中文原因（不含密钥）
  discoveryError     String?  @map("discovery_error") @db.Text
  // 当前有效快照版本号（无快照为 null）
  snapshotVersion    Int?     @map("snapshot_version")
  // 安全配置指纹（服务端推导；配置变更即变化，令旧审批失效）
  configFingerprint  String?  @map("config_fingerprint")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots McpToolSnapshot[]
  policies  McpToolPolicy[]
  audits    McpAuditRecord[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("mcp_server_configs")
}

// MCP 工具定义快照（用户手动刷新时原子写入；ADR-0064）
model McpToolSnapshot {
  id                String   @id @default(cuid())
  serverId          String
  userId            String
  version           Int
  // 快照总字节数（上限 256KB）
  totalBytes        Int      @default(0) @map("total_bytes")
  // 工具定义列表（JSON：工具名、描述、inputSchema、注解、模型侧名）
  tools             Json     @default("[]")
  // 该快照对应的安全配置指纹
  configFingerprint String   @map("config_fingerprint")
  createdAt         DateTime @default(now())

  server McpServerConfig @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, version])
  @@index([userId])
  @@index([serverId, version])
  @@map("mcp_tool_snapshots")
}

// MCP 工具策略（白名单与审批策略；ADR-0064）
model McpToolPolicy {
  id               String   @id @default(cuid())
  serverId         String
  userId           String
  // 上游原始工具名
  toolName         String   @map("tool_name")
  // 是否加入白名单（进入 Agent 上下文）
  enabled          Boolean  @default(false)
  // 是否允许自动执行；false 表示必须经用户审批
  allowAutoExecute Boolean  @default(false) @map("allow_auto_execute")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  server McpServerConfig @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, toolName])
  @@index([userId])
  @@index([userId, enabled])
  @@map("mcp_tool_policies")
}

// MCP 元数据审计（不落原始参数、返回正文、鉴权信息与 URL 查询串；ADR-0064）
model McpAuditRecord {
  id             String   @id @default(cuid())
  userId         String
  serverId       String?
  // 来源服务器名称（冗余留痕，便于按名称检索）
  serverName     String?  @map("server_name")
  // 工具名；服务器级事件为空
  toolName       String?  @map("tool_name")
  // 目标域名（不含路径与查询串）
  hostname       String
  // 事件类型：discover / refresh / call / pending_approval / blocked
  eventType      String   @map("event_type")
  // 结果状态：success / failed / skipped / blocked / pending_approval
  outcome        String
  snapshotVersion Int?    @map("snapshot_version")
  statusCode     Int?     @map("status_code")
  durationMs     Int      @default(0) @map("duration_ms")
  responseBytes  Int      @default(0) @map("response_bytes")
  // 错误类别（不含原始错误细节与密钥）
  errorKind       String?  @map("error_kind")
  createdAt      DateTime @default(now())

  server McpServerConfig? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serverId])
  @@index([createdAt])
  @@map("mcp_audit_records")
}

// 前端行为埋点事件记录（ADR-0013 / P0a 工单 03）
model ProductEvent {
  id        String   @id @default(cuid())
  userId    String
  event     String
  props     Json     @default("{}")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([event, createdAt])
  @@map("product_events")
}

// 智能体运行记录（ADR-0015 / P1 工单 02）
model AgentRun {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  messageId      String?
  goalText       String   @db.Text
  steps          Int      @default(1)
  toolCalls      Json     @default("[]")
  artifactRefs   Json     @default("[]")
  capabilityPack String?
  outcome        String   // 结果状态：success / partial / failed
  quotaCost      Int      @default(0)
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("agent_runs")
}

// 知识库表（RAG 知识库，不含 embedding 模型与维度字段，收敛为全局常量）
model KnowledgeBase {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  name        String
  description String?   @db.Text
  status      String    @default("active") // "active" | "archived"
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]
  evalCases   RagEvalCase[]
  chunks      DocumentChunk[]
  faqs        KnowledgeFaq[]
  faqQuestions KnowledgeFaqQuestion[]

  @@index([userId])
  @@map("knowledge_bases")
}

// 知识库文档表（状态机：pending -> ready / failed，单调版本号，软删除）
model Document {
  id              String    @id @default(cuid())
  knowledgeBaseId String    @map("knowledge_base_id")
  userId          String    @map("user_id") // 冗余用户 ID，供检索期前置 ACL 过滤
  name            String
  storageKey      String    @map("storage_key")
  status          String    @default("pending") // "pending" | "processing" | "ready" | "failed"
  version         Int       @default(1)
  chunkCount      Int       @default(0) @map("chunk_count")
  errorMessage    String?   @map("error_message") @db.Text
  sourceType      String    @default("file") @map("source_type") // "file" | "url"
  sourceUrl       String?   @map("source_url") @db.Text
  tags            String[]  @default([])
  metadata        Json      @default("{}")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  knowledgeBase   KnowledgeBase   @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks          DocumentChunk[]

  @@index([knowledgeBaseId])
  @@index([userId])
  @@index([status])
  @@map("documents")
}

// 文档切片表（稠密向量 + 词法检索，HNSW 索引，版本化唯一约束）
model DocumentChunk {
  id               String   @id @default(cuid())
  documentId       String   @map("document_id")
  knowledgeBaseId  String   @map("knowledge_base_id") // 冗余供前置过滤
  userId           String   @map("user_id") // 冗余供前置 ACL 过滤
  documentVersion  Int      @map("document_version")
  chunkIndex       Int      @map("chunk_index")
  content          String   @db.Text
  contentSegmented String   @map("content_segmented") @db.Text // jieba 应用层分词结果（空格分隔）
  headingPath      String?  @map("heading_path") // Markdown 标题路径
  pageNumber       Int?     @map("page_number") // PDF 页码
  tokenCount       Int      @default(0) @map("token_count")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  // Unsupported 字段由 raw SQL 维护
  contentTsv       Unsupported("tsvector")? @map("content_tsv")
  embedding        Unsupported("vector(1024)")?

  document         Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeBase    KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, documentVersion, chunkIndex])
  @@index([knowledgeBaseId, userId])
  @@index([documentId])
  @@map("document_chunks")
}

// 会话记忆切片表（opt-in 开启，按消息水位线索引，支持双源路由记忆检索）
model ConversationMemoryChunk {
  id               String   @id @default(cuid())
  userId           String   @map("user_id") // 强制跨用户隔离过滤
  sessionId        String   @map("session_id")
  messageId        String?  @map("message_id") // 溯源到消息 ID
  chunkIndex       Int      @map("chunk_index")
  content          String   @db.Text
  contentSegmented String   @map("content_segmented") @db.Text
  tokenCount       Int      @default(0) @map("token_count")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  // Unsupported 字段由 raw SQL 维护
  contentTsv       Unsupported("tsvector")? @map("content_tsv")
  embedding        Unsupported("vector(1024)")?

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session          ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, chunkIndex])
  @@index([userId])
  @@index([sessionId])
  @@map("conversation_memory_chunks")
}

// RAG 评测用例表（金标为 (documentId, version, chunkIndex) 三元组 JSON 数组）
model RagEvalCase {
  id              String   @id @default(cuid())
  knowledgeBaseId String   @map("knowledge_base_id")
  question        String   @db.Text
  referenceAnswer String   @map("reference_answer") @db.Text
  goldenAnchors   Json     @map("golden_anchors") // 三元组锚点数组
  category        String   @default("answerable") // "answerable" | "unanswerable" | "cross_paragraph" | "injection"
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@index([category])
  @@map("rag_eval_cases")
}

// 知识库标准问答对主表 (ADR-0027)
model KnowledgeFaq {
  id              String    @id @default(cuid())
  knowledgeBaseId String    @map("knowledge_base_id")
  userId          String    @map("user_id") // 冗余供前置 ACL
  question        String    @db.Text
  answer          String    @db.Text
  enabled         Boolean   @default(true)
  hitCount        Int       @default(0) @map("hit_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  knowledgeBase   KnowledgeBase          @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions       KnowledgeFaqQuestion[]

  @@index([knowledgeBaseId, userId])
  @@index([userId, enabled])
  @@map("knowledge_faqs")
}

// 问答对问法扁平化索引表 (Sentence-to-Sentence, 1024维向量 + jieba词法)
model KnowledgeFaqQuestion {
  id                String   @id @default(cuid())
  faqId             String   @map("faq_id")
  knowledgeBaseId   String   @map("knowledge_base_id") // 冗余供前置过滤
  userId            String   @map("user_id") // 冗余供前置 ACL
  questionText      String   @map("question_text") @db.Text
  questionSegmented String   @map("question_segmented") @db.Text
  isPrimary         Boolean  @default(false) @map("is_primary") // 是否为主标准问
  createdAt         DateTime @default(now()) @map("created_at")

  // Unsupported 字段由 raw SQL 维护
  questionTsv       Unsupported("tsvector")? @map("question_tsv")
  embedding         Unsupported("vector(1024)")?

  faq               KnowledgeFaq  @relation(fields: [faqId], references: [id], onDelete: Cascade)
  knowledgeBase     KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([faqId])
  @@index([knowledgeBaseId, userId])
  @@map("knowledge_faq_questions")
}

// ============================================
// Agent 端到端评测基准与消融观测模型
// ============================================

model AgentEvalRun {
  id               String                @id @default(uuid())
  suiteId          String?               @map("suite_id")
  runType          String                @default("standalone") @map("run_type") // "standalone" | "ablation" | "cross_model"
  experimentLabel  String?               @map("experiment_label") // "基准全量组" | "混合检索无Rerank" | "无质检反思"
  datasetVersion   String                @map("dataset_version")  // "agent-benchmark-v1"
  modelProvider    String                @map("model_provider")   // "deepseek" | "doubao" | "xunfei"
  modelId          String                @map("model_id")
  commitHash       String?               @map("commit_hash")
  isDirty          Boolean               @default(false) @map("is_dirty")
  isBenchmark      Boolean               @default(true) @map("is_benchmark") // smoke 运行时为 false，不计入正式横评大盘
  configSnapshot   Json                  @map("config_snapshot")  // 记录 Rerank、EvaluatorNode、MaxSteps 等开关
  totalCases       Int                   @map("total_cases")
  passedCases      Int                   @map("passed_cases")
  passRate         Float                 @map("pass_rate")
  avgLatencyMs     Float                 @map("avg_latency_ms")
  totalTokens      Int                   @default(0) @map("total_tokens")
  usageEstimated   Boolean               @default(false) @map("usage_estimated")
  estimatedCostRmb Float                 @default(0) @map("estimated_cost_rmb")
  judgeModel       String?               @map("judge_model")
  avgJudgeScore    Float?                @map("avg_judge_score")
  caseResults      AgentEvalCaseResult[]
  createdAt        DateTime              @default(now()) @map("created_at")

  @@index([suiteId])
  @@index([modelProvider, modelId])
  @@index([isBenchmark, createdAt])
  @@map("agent_eval_runs")
}

model AgentEvalCaseResult {
  id           String       @id @default(uuid())
  evalRunId    String       @map("eval_run_id")
  caseId       String       @map("case_id")
  category     String       // "planning" | "tools" | "security" | "rag"
  passed       Boolean
  score        Float        @default(0) // 客观确定性得分：1.0 (通过) / 0.0 (未通过)
  judgeScore   Float?       @map("judge_score") // 仅在启用裁判模型时记录 1.0~5.0 主观打分
  latencyMs    Int          @map("latency_ms")
  tokensUsed   Int          @map("tokens_used")
  errorDetail  String?      @map("error_detail")
  traceData    Json?        @map("trace_data") // 记录脱敏后的输入、AgentPlan、召回 chunk、工具调用与响应结果（上限 32KB）

  evalRun      AgentEvalRun @relation(fields: [evalRunId], references: [id], onDelete: Cascade)

  @@index([evalRunId, category])
  @@index([caseId])
  @@map("agent_eval_case_results")
}




