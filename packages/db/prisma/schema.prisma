generator client {
  provider      = "prisma-client-js"
  // 本地 macOS + Vercel Linux（OpenSSL 3）运行时引擎
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?
  name          String?
  passwordHash  String?
  role          String   @default("user")   // 用户角色："user"（普通用户）| "admin"（管理员）
  status        String   @default("active") // 账号状态："active"（正常）| "disabled"（已禁用）
  tokens        Int      @default(20000)    // AI Token 剩余额度（每次调用按实际用量扣减）
  memorySearchEnabled Boolean @default(false) @map("memory_search_enabled") // 会话记忆检索开关（默认关闭，opt-in）
  emailVerified DateTime?
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions            ChatSession[]
  tasks               Task[]
  aiUsageRecords      AIUsageRecord[]
  voiceTranscriptions VoiceTranscription[]
  chatHistory         ChatHistory[]        @relation("ChatHistoryToUser")
  imageHistory        ImageHistory[]       @relation("ImageHistoryToUser")
  voiceHistory        VoiceHistory[]       @relation("VoiceHistoryToUser")
  oauthAccounts       OAuthAccount[]
  refreshTokens       RefreshToken[]
  feedbacks           Feedback[]
  feedbackReplies     FeedbackReply[]
  quotaAccount        QuotaAccount?
  quotaReservations   QuotaReservation[]
  quotaLedgerEntries  QuotaLedgerEntry[]
  webhookTools        UserWebhookTool[]
  webhookToolCalls    WebhookToolCall[]
  productEvents       ProductEvent[]
  agentRuns           AgentRun[]
  knowledgeBases      KnowledgeBase[]
  documents           Document[]
  documentChunks      DocumentChunk[]
  conversationMemoryChunks ConversationMemoryChunk[]
  knowledgeFaqs       KnowledgeFaq[]
  knowledgeFaqQuestions KnowledgeFaqQuestion[]
  @@map("users")
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  memoryChunks ConversationMemoryChunk[]

  @@index([userId])
  @@map("chat_sessions")
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  requestId   String?
  providerTaskId String?
  type        String
  status      String    @default("pending")
  input       Json
  output      Json?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@unique([userId, requestId])
  @@unique([userId, providerTaskId])
  @@map("tasks")
}

model AIUsageRecord {
  id              String   @id @default(cuid())
  userId          String
  feature         String
  action          String
  provider        String?
  model           String?
  endpoint        String?
  requestId       String?
  inputTokens     Int?
  outputTokens    Int?
  totalTokens     Int?
  cachedTokens    Int?
  reasoningTokens Int?
  taskCount       Int      @default(1)
  status          String   @default("success")
  meterType       String?
  billableUnits   Int?
  billingStatus   String?
  reservationId   String?  @unique
  rawUsage        Json?
  metadata        Json?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation QuotaReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, feature, createdAt])
  @@index([provider, model])
  @@unique([userId, requestId])
  @@map("ai_usage_records")
}

model QuotaAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  grantedUnits   Int      @default(0)
  availableUnits Int      @default(0)
  reservedUnits  Int      @default(0)
  settledUnits   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations    QuotaReservation[]
  ledgerEntries   QuotaLedgerEntry[]

  @@map("quota_accounts")
}

model QuotaReservation {
  id             String   @id @default(cuid())
  userId         String
  requestId      String
  feature        String
  provider       String?
  model          String?
  meterType      String   @default("tokens")
  estimatedUnits Int
  settledUnits   Int      @default(0)
  status         String   @default("reserved")
  executionState String   @default("ready")
  expiresAt      DateTime
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "quota_reservations_user_id_fkey")
  account       QuotaAccount       @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "quota_reservations_account_user_id_fkey")
  aiUsageRecord AIUsageRecord?
  ledgerEntries QuotaLedgerEntry[]

  @@unique([userId, requestId])
  @@index([status, executionState, expiresAt])
  @@index([userId, createdAt])
  @@map("quota_reservations")
}

model QuotaLedgerEntry {
  id            String   @id @default(cuid())
  userId        String
  reservationId String?
  requestId     String
  eventType     String
  units         Int
  meterType     String
  feature       String?
  provider      String?
  model         String?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "quota_ledger_entries_user_id_fkey")
  account     QuotaAccount       @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "quota_ledger_entries_account_user_id_fkey")
  reservation QuotaReservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([requestId, eventType])
  @@index([userId, createdAt])
  @@index([reservationId])
  @@map("quota_ledger_entries")
}

model VoiceTranscription {
  id            String    @id @default(cuid())
  userId        String
  fileName      String
  fileSize      Int
  duration      Int?
  format        String
  model         String    @default("FunAudioLLM/SenseVoiceSmall")
  status        String    @default("pending")
  transcription String?   @db.Text
  error         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("voice_transcriptions")
}

model ChatHistory {
  id        String   @id @default(cuid())
  userId    String
  title     String
  preview   String   @db.Text
  model     String
  provider  String
  messages  Json
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, name: "ChatHistoryToUser")

  @@index([userId])
  @@index([createdAt])
  @@map("chat_history")
}

model ImageHistory {
  id            String   @id @default(cuid())
  userId        String
  title         String?
  prompt        String   @db.Text
  negativePrompt String?  @db.Text
  model         String
  style         String?
  aspectRatio   String?
  imageUrl      String
  parameters    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, name: "ImageHistoryToUser")

  @@index([userId])
  @@index([createdAt])
  @@map("image_history")
}

model VoiceHistory {
  id            String   @id @default(cuid())
  userId        String
  title         String
  preview       String   @db.Text
  model         String
  duration      String
  fileName      String
  fileSize      Int
  transcription String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, name: "VoiceHistoryToUser")

  @@index([userId])
  @@index([createdAt])
  @@map("voice_history")
}

// 反馈类型枚举
enum FeedbackType {
  BUG
  FEATURE
  UI
  PERFORMANCE
  OTHER
}

// 反馈状态枚举
enum FeedbackStatus {
  PENDING
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

// 反馈优先级枚举
enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Feedback {
  id          String           @id @default(cuid())
  userId      String
  type        FeedbackType
  status      FeedbackStatus   @default(PENDING)
  priority    FeedbackPriority @default(MEDIUM)
  title       String
  content     String           @db.Text
  isPinned    Boolean          @default(false)
  tags        String[]         @default([])
  replyCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     FeedbackReply[]
  attachments FeedbackAttachment[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([isPinned])
  @@index([createdAt])
  @@map("feedbacks")
}

model FeedbackReply {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  content    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([userId])
  @@index([createdAt])
  @@map("feedback_replies")
}

model FeedbackAttachment {
  id         String   @id @default(cuid())
  feedbackId String
  fileName   String
  fileSize   Int
  fileType   String
  fileUrl    String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@map("feedback_attachments")
}

model FeedbackTag {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#5D7CFA")
  description String?
  createdAt   DateTime @default(now())

  @@map("feedback_tags")
}

// Webhook 请求方法枚举
enum WebhookHttpMethod {
  GET
  POST
}

// 用户自定义 Webhook 工具定义
model UserWebhookTool {
  id                 String            @id @default(cuid())
  userId             String
  name               String
  callName           String
  description        String            @db.Text
  url                String            @db.Text
  method             WebhookHttpMethod @default(POST)
  authHeaderName     String?
  authHeaderValueEnc String?           @db.Text
  params             Json              @default("[]")
  enabled            Boolean           @default(true)
  // 调用前是否需要用户确认（AGENT-HITL-ACTION / ADR-0041）：新建时 POST 默认 true、GET 默认 false，由 API 层按 method 填入
  requiresApproval   Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  calls              WebhookToolCall[]

  @@unique([userId, callName])
  @@index([userId])
  @@index([userId, enabled])
  @@map("user_webhook_tools")
}

// Webhook 工具调用审计记录
model WebhookToolCall {
  id            String            @id @default(cuid())
  userId        String
  toolId        String?
  hostname      String
  method        WebhookHttpMethod
  statusCode    Int?
  durationMs    Int
  responseBytes Int               @default(0)
  outcome       String            // 结果状态：success / failed / skipped / blocked / pending_approval（等待用户确认，不计入成功率分母）
  errorKind     String?
  createdAt     DateTime          @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool          UserWebhookTool?  @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([toolId])
  @@index([createdAt])
  @@map("webhook_tool_calls")
}

// 前端行为埋点事件记录（ADR-0013 / P0a 工单 03）
model ProductEvent {
  id        String   @id @default(cuid())
  userId    String
  event     String
  props     Json     @default("{}")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([event, createdAt])
  @@map("product_events")
}

// 智能体运行记录（ADR-0015 / P1 工单 02）
model AgentRun {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  messageId      String?
  goalText       String   @db.Text
  steps          Int      @default(1)
  toolCalls      Json     @default("[]")
  artifactRefs   Json     @default("[]")
  capabilityPack String?
  outcome        String   // 结果状态：success / partial / failed
  quotaCost      Int      @default(0)
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("agent_runs")
}

// 知识库表（RAG 知识库，不含 embedding 模型与维度字段，收敛为全局常量）
model KnowledgeBase {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  name        String
  description String?   @db.Text
  status      String    @default("active") // "active" | "archived"
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]
  evalCases   RagEvalCase[]
  chunks      DocumentChunk[]
  faqs        KnowledgeFaq[]
  faqQuestions KnowledgeFaqQuestion[]

  @@index([userId])
  @@map("knowledge_bases")
}

// 知识库文档表（状态机：pending -> ready / failed，单调版本号，软删除）
model Document {
  id              String    @id @default(cuid())
  knowledgeBaseId String    @map("knowledge_base_id")
  userId          String    @map("user_id") // 冗余用户 ID，供检索期前置 ACL 过滤
  name            String
  storageKey      String    @map("storage_key")
  status          String    @default("pending") // "pending" | "processing" | "ready" | "failed"
  version         Int       @default(1)
  chunkCount      Int       @default(0) @map("chunk_count")
  errorMessage    String?   @map("error_message") @db.Text
  sourceType      String    @default("file") @map("source_type") // "file" | "url"
  sourceUrl       String?   @map("source_url") @db.Text
  tags            String[]  @default([])
  metadata        Json      @default("{}")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  knowledgeBase   KnowledgeBase   @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks          DocumentChunk[]

  @@index([knowledgeBaseId])
  @@index([userId])
  @@index([status])
  @@map("documents")
}

// 文档切片表（稠密向量 + 词法检索，HNSW 索引，版本化唯一约束）
model DocumentChunk {
  id               String   @id @default(cuid())
  documentId       String   @map("document_id")
  knowledgeBaseId  String   @map("knowledge_base_id") // 冗余供前置过滤
  userId           String   @map("user_id") // 冗余供前置 ACL 过滤
  documentVersion  Int      @map("document_version")
  chunkIndex       Int      @map("chunk_index")
  content          String   @db.Text
  contentSegmented String   @map("content_segmented") @db.Text // jieba 应用层分词结果（空格分隔）
  headingPath      String?  @map("heading_path") // Markdown 标题路径
  pageNumber       Int?     @map("page_number") // PDF 页码
  tokenCount       Int      @default(0) @map("token_count")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  // Unsupported 字段由 raw SQL 维护
  contentTsv       Unsupported("tsvector")? @map("content_tsv")
  embedding        Unsupported("vector(1024)")?

  document         Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  knowledgeBase    KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, documentVersion, chunkIndex])
  @@index([knowledgeBaseId, userId])
  @@index([documentId])
  @@map("document_chunks")
}

// 会话记忆切片表（opt-in 开启，按消息水位线索引，支持双源路由记忆检索）
model ConversationMemoryChunk {
  id               String   @id @default(cuid())
  userId           String   @map("user_id") // 强制跨用户隔离过滤
  sessionId        String   @map("session_id")
  messageId        String?  @map("message_id") // 溯源到消息 ID
  chunkIndex       Int      @map("chunk_index")
  content          String   @db.Text
  contentSegmented String   @map("content_segmented") @db.Text
  tokenCount       Int      @default(0) @map("token_count")
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  // Unsupported 字段由 raw SQL 维护
  contentTsv       Unsupported("tsvector")? @map("content_tsv")
  embedding        Unsupported("vector(1024)")?

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  session          ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, chunkIndex])
  @@index([userId])
  @@index([sessionId])
  @@map("conversation_memory_chunks")
}

// RAG 评测用例表（金标为 (documentId, version, chunkIndex) 三元组 JSON 数组）
model RagEvalCase {
  id              String   @id @default(cuid())
  knowledgeBaseId String   @map("knowledge_base_id")
  question        String   @db.Text
  referenceAnswer String   @map("reference_answer") @db.Text
  goldenAnchors   Json     @map("golden_anchors") // 三元组锚点数组
  category        String   @default("answerable") // "answerable" | "unanswerable" | "cross_paragraph" | "injection"
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
  @@index([category])
  @@map("rag_eval_cases")
}

// 知识库标准问答对主表 (ADR-0027)
model KnowledgeFaq {
  id              String    @id @default(cuid())
  knowledgeBaseId String    @map("knowledge_base_id")
  userId          String    @map("user_id") // 冗余供前置 ACL
  question        String    @db.Text
  answer          String    @db.Text
  enabled         Boolean   @default(true)
  hitCount        Int       @default(0) @map("hit_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  knowledgeBase   KnowledgeBase          @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions       KnowledgeFaqQuestion[]

  @@index([knowledgeBaseId, userId])
  @@index([userId, enabled])
  @@map("knowledge_faqs")
}

// 问答对问法扁平化索引表 (Sentence-to-Sentence, 1024维向量 + jieba词法)
model KnowledgeFaqQuestion {
  id                String   @id @default(cuid())
  faqId             String   @map("faq_id")
  knowledgeBaseId   String   @map("knowledge_base_id") // 冗余供前置过滤
  userId            String   @map("user_id") // 冗余供前置 ACL
  questionText      String   @map("question_text") @db.Text
  questionSegmented String   @map("question_segmented") @db.Text
  isPrimary         Boolean  @default(false) @map("is_primary") // 是否为主标准问
  createdAt         DateTime @default(now()) @map("created_at")

  // Unsupported 字段由 raw SQL 维护
  questionTsv       Unsupported("tsvector")? @map("question_tsv")
  embedding         Unsupported("vector(1024)")?

  faq               KnowledgeFaq  @relation(fields: [faqId], references: [id], onDelete: Cascade)
  knowledgeBase     KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([faqId])
  @@index([knowledgeBaseId, userId])
  @@map("knowledge_faq_questions")
}



