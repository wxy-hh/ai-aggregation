generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  email         String?
  name          String?
  passwordHash  String?
  role          String   @default("user")   // "user" | "admin"
  status        String   @default("active") // "active" | "disabled"
  tokens        Int      @default(20000)    // AI Token 剩余额度（每次调用按实际用量扣减）
  isAnonymous   Boolean  @default(false)    // 是否为匿名用户（设备指纹自动创建）
  deviceHash    String?  @unique            // 匿名用户设备哈希，用于查找与去重
  emailVerified DateTime?
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions            ChatSession[]
  tasks               Task[]
  aiUsageRecords      AIUsageRecord[]
  voiceTranscriptions VoiceTranscription[]
  chatHistory         ChatHistory[]        @relation("ChatHistoryToUser")
  imageHistory        ImageHistory[]       @relation("ImageHistoryToUser")
  voiceHistory        VoiceHistory[]       @relation("VoiceHistoryToUser")
  oauthAccounts       OAuthAccount[]
  refreshTokens       RefreshToken[]
  feedbacks           Feedback[]
  feedbackReplies     FeedbackReply[]
  quotaAccount        QuotaAccount?
  quotaReservations   QuotaReservation[]
  quotaLedgerEntries  QuotaLedgerEntry[]
  @@map("users")
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@map("chat_sessions")
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  requestId   String?
  providerTaskId String?
  type        String
  status      String    @default("pending")
  input       Json
  output      Json?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@unique([userId, requestId])
  @@unique([userId, providerTaskId])
  @@map("tasks")
}

model AIUsageRecord {
  id              String   @id @default(cuid())
  userId          String
  feature         String
  action          String
  provider        String?
  model           String?
  endpoint        String?
  requestId       String?
  inputTokens     Int?
  outputTokens    Int?
  totalTokens     Int?
  cachedTokens    Int?
  reasoningTokens Int?
  taskCount       Int      @default(1)
  status          String   @default("success")
  meterType       String?
  billableUnits   Int?
  billingStatus   String?
  reservationId   String?  @unique
  rawUsage        Json?
  metadata        Json?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation QuotaReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, feature, createdAt])
  @@index([provider, model])
  @@unique([userId, requestId])
  @@map("ai_usage_records")
}

model QuotaAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  grantedUnits   Int      @default(0)
  availableUnits Int      @default(0)
  reservedUnits  Int      @default(0)
  settledUnits   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations    QuotaReservation[]
  ledgerEntries   QuotaLedgerEntry[]

  @@map("quota_accounts")
}

model QuotaReservation {
  id             String   @id @default(cuid())
  userId         String
  requestId      String
  feature        String
  provider       String?
  model          String?
  meterType      String   @default("tokens")
  estimatedUnits Int
  settledUnits   Int      @default(0)
  status         String   @default("reserved")
  executionState String   @default("ready")
  expiresAt      DateTime
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "quota_reservations_user_id_fkey")
  account       QuotaAccount       @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "quota_reservations_account_user_id_fkey")
  aiUsageRecord AIUsageRecord?
  ledgerEntries QuotaLedgerEntry[]

  @@unique([userId, requestId])
  @@index([status, executionState, expiresAt])
  @@index([userId, createdAt])
  @@map("quota_reservations")
}

model QuotaLedgerEntry {
  id            String   @id @default(cuid())
  userId        String
  reservationId String?
  requestId     String
  eventType     String
  units         Int
  meterType     String
  feature       String?
  provider      String?
  model         String?
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "quota_ledger_entries_user_id_fkey")
  account     QuotaAccount       @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "quota_ledger_entries_account_user_id_fkey")
  reservation QuotaReservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([requestId, eventType])
  @@index([userId, createdAt])
  @@index([reservationId])
  @@map("quota_ledger_entries")
}

model VoiceTranscription {
  id            String    @id @default(cuid())
  userId        String
  fileName      String
  fileSize      Int
  duration      Int?
  format        String
  model         String    @default("FunAudioLLM/SenseVoiceSmall")
  status        String    @default("pending")
  transcription String?   @db.Text
  error         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("voice_transcriptions")
}

model ChatHistory {
  id        String   @id @default(cuid())
  userId    String
  title     String
  preview   String   @db.Text
  model     String
  provider  String
  messages  Json
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, name: "ChatHistoryToUser")

  @@index([userId])
  @@index([createdAt])
  @@map("chat_history")
}

model ImageHistory {
  id            String   @id @default(cuid())
  userId        String
  title         String?
  prompt        String   @db.Text
  negativePrompt String?  @db.Text
  model         String
  style         String?
  aspectRatio   String?
  imageUrl      String
  parameters    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, name: "ImageHistoryToUser")

  @@index([userId])
  @@index([createdAt])
  @@map("image_history")
}

model VoiceHistory {
  id            String   @id @default(cuid())
  userId        String
  title         String
  preview       String   @db.Text
  model         String
  duration      String
  fileName      String
  fileSize      Int
  transcription String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, name: "VoiceHistoryToUser")

  @@index([userId])
  @@index([createdAt])
  @@map("voice_history")
}

// 反馈类型枚举
enum FeedbackType {
  BUG
  FEATURE
  UI
  PERFORMANCE
  OTHER
}

// 反馈状态枚举
enum FeedbackStatus {
  PENDING
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

// 反馈优先级枚举
enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Feedback {
  id          String           @id @default(cuid())
  userId      String
  type        FeedbackType
  status      FeedbackStatus   @default(PENDING)
  priority    FeedbackPriority @default(MEDIUM)
  title       String
  content     String           @db.Text
  isPinned    Boolean          @default(false)
  tags        String[]         @default([])
  replyCount  Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     FeedbackReply[]
  attachments FeedbackAttachment[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([isPinned])
  @@index([createdAt])
  @@map("feedbacks")
}

model FeedbackReply {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  content    String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([userId])
  @@index([createdAt])
  @@map("feedback_replies")
}

model FeedbackAttachment {
  id         String   @id @default(cuid())
  feedbackId String
  fileName   String
  fileSize   Int
  fileType   String
  fileUrl    String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@map("feedback_attachments")
}

model FeedbackTag {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String   @default("#5D7CFA")
  description String?
  createdAt   DateTime @default(now())

  @@map("feedback_tags")
}
