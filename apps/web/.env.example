# ============================================
# 数据库配置
# ============================================
# PostgreSQL 连接字符串
# 本地开发: postgresql://user:password@localhost:5432/ai_aggregation
# Supabase: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]
DATABASE_URL="postgresql://user:password@localhost:5432/ai_aggregation"

# ============================================
# Redis 配置（用于 BullMQ 队列）
# ============================================
# 本地开发
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Upstash Redis（推荐用于生产环境）
# REDIS_HOST="your-redis.upstash.io"
# REDIS_PORT="6379"
# REDIS_PASSWORD="your-redis-password"

# ============================================
# 对象存储配置（可选）
# ============================================
# MinIO（本地开发）
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="ai-aggregation"

# 阿里云 OSS（生产环境）
# OSS_ACCESS_KEY_ID="your-access-key-id"
# OSS_ACCESS_KEY_SECRET="your-access-key-secret"
# OSS_BUCKET="your-bucket-name"
# OSS_REGION="oss-cn-hangzhou"

# ============================================
# AI 服务商 API Keys
# ============================================

# 通义千问（DashScope）
DASHSCOPE_API_KEY="sk-your-dashscope-api-key"

# 智谱 GLM
ZHIPU_API_KEY="your-zhipu-api-key"

# DeepSeek
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"

# 硅基流动（Kolors 图像生成）
SILICONFLOW_API_KEY="sk-your-siliconflow-api-key"
SILICONFLOW_API_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_DEFAULT_MODEL="FunAudioLLM/SenseVoiceSmall"

# 讯飞星火
XUNFEI_API_PASSWORD="your-xunfei-api-password"

# 豆包（火山方舟）
ARK_API_KEY="your-ark-api-key"
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
ARK_MODEL="doubao-seed-evolving"
ARK_DESTINY_MODEL="doubao-seed-2-1-pro-260628"

# ============================================
# 媒体代理白名单（/api/image/proxy、/api/video/proxy）
# ============================================
# 逗号分隔的额外白名单域名，会追加在代码内默认白名单之后
# （默认：storage.googleapis.com = Agnes 生成结果域名；sfile.chatglm.cn = 智谱 CogVideoX 视频结果域名）
# 格式：example.com（含子域名、任意端口）、example.com:8443（仅该端口）
# 仅允许 https；唯一允许 http 的场景是显式声明的本机地址（本地 MinIO 开发），如：localhost:9000,127.0.0.1:9000
MEDIA_PROXY_ALLOWED_DOMAINS=""

# ============================================
# 阿里云邮件推送（DirectMail）
# ============================================
# 用途：注册验证码、绑定邮箱验证码、忘记密码重置邮件。
# 未配置凭证时：发送验证码/触发重置邮件的接口统一返回 503（内测环境可无邮件通道跑通其余流程）。
# 发信地址需先在阿里云邮件推送控制台创建并完成域名解析（SPF/DKIM）。
ALIYUN_DM_ACCESS_KEY_ID="your-access-key-id"
ALIYUN_DM_ACCESS_KEY_SECRET="your-access-key-secret"
# 发信地址（控制台已配置的地址，如 noreply@mail.example.com）
ALIYUN_DM_ACCOUNT_NAME="noreply@mail.example.com"
# 发件人昵称（可选）
ALIYUN_DM_FROM_ALIAS="AI 聚合平台"
# 区域，默认 cn-hangzhou
ALIYUN_DM_REGION="cn-hangzhou"

# ============================================
# 应用配置
# ============================================
# Next.js 应用 URL
NEXT_PUBLIC_APP_URL="http://localhost:3030"

# 自研认证的 JWT（HS256）access token 签名密钥（生产环境请用 openssl rand -hex 32 生成强密钥）
# 注意：改动它会让全部已签发的 access token 立即失效；客户端会用 cookie 里的 refresh token 静默换新，无需重新登录
AUTH_SECRET="your-auth-secret-change-this-in-production"
# 匿名设备指纹哈希盐（HMAC-SHA256），匿名建号时用于把 deviceId 映射为稳定用户；改动会使同一设备重新建号
ANONYMOUS_DEVICE_SALT="your-anonymous-device-salt-change-this-in-production"
# 用户自定义 Webhook 工具凭证加密密钥（AES-256-GCM，32 字节 hex；未配置时加解密 fail-closed）
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET_KEY=

# ============================================
# 认证接口限流
# ============================================
# 认证接口（登录/注册/忘记密码/重置密码）限流设施故障时的处置模式。
# 留空或设为 closed（默认）：Redis 异常/超时时拒绝认证请求（503），安全防线不因基础设施抖动消失。
# 仅在 Redis 长时间故障、需要临时恢复登录能力时设为 open 应急放行，恢复后请立刻改回。
AUTH_RATE_LIMIT_FAILURE_MODE="closed"
