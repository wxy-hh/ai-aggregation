{
  "enforcement": {
    "gitWriteRequiresLogicComplete": true,
    "mode": "strict",
    "oneActiveFeature": true,
    "requireExplicitHumanReply": true
  },
  "protectedRoots": [
    "apps/web/src",
    "apps/web/e2e",
    "apps/worker/src",
    "packages/shared",
    "packages/providers",
    "packages/db",
    "packages/queue",
    "packages/storage",
    "packages/logger",
    "packages/config-eslint",
    "packages/config-typescript",
    "infra/docker",
    "infra/worker-rtasr",
    "tooling/scripts",
    "scripts",
    "migrations"
  ],
  "schemaVersion": 1,
  "verification": {
    "behaviorCommands": [
      "unit",
      "lint",
      "typecheck"
    ],
    "commands": [
      {
        "args": [
          "test"
        ],
        "command": "pnpm",
        "cwd": ".",
        "id": "unit"
      },
      {
        "args": [
          "lint"
        ],
        "command": "pnpm",
        "cwd": ".",
        "id": "lint"
      },
      {
        "args": [
          "typecheck"
        ],
        "command": "pnpm",
        "cwd": ".",
        "id": "typecheck"
      },
      {
        "args": [
          "build"
        ],
        "command": "pnpm",
        "cwd": ".",
        "id": "build"
      },
      {
        "args": [
          "test:e2e"
        ],
        "command": "pnpm",
        "cwd": ".",
        "id": "e2e"
      }
    ]
  }
}