# ============================================
# AI-Aggregation 生产环境变量模板
# 复制为 .env.prod 并填入真实值
# ============================================

# ---------- 应用配置 ----------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com
AUTH_SECRET=  # openssl rand -hex 32
ANONYMOUS_DEVICE_SALT=  # openssl rand -hex 16

# ---------- 数据库（腾讯云 PostgreSQL）----------
DATABASE_URL=

# ---------- Redis（腾讯云 Redis）----------
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
# 或使用 URL 格式：REDIS_URL=rediss://default:password@host:6379

# ---------- 对象存储（腾讯云 COS）----------
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=

# ---------- AI 服务商 API Keys ----------
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1
SILICONFLOW_DEFAULT_MODEL=FunAudioLLM/SenseVoiceSmall

# 豆包（火山方舟）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
ARK_DESTINY_MODEL=

# 讯飞
XUNFEI_API_PASSWORD=
XUNFEI_APP_ID=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=

# Agnes 图像/视频
AGNES_API_KEY=
AGNES_INFERENCE_API_URL=

# ---------- 内部服务 ----------
BILLING_RECONCILE_SECRET=  # openssl rand -hex 24
RTASR_GATEWAY_SECRET=  # openssl rand -hex 24
